# ==============================================================================
# InterviewOS — Environment Variables Template
# ==============================================================================
# IMPORTANT: Copy this file to .env and populate with your local values.
# NEVER commit the actual .env file or hardcode keys into code or documentation.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
DEBUG=True

# Database (PostgreSQL)
# Local lightweight setup or cloud serverless instance (Neon / Supabase)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/interviewos

# Cache (Redis)
# Use redis://localhost:6379/0 or memory:// for in-memory fallback
REDIS_URL=memory://

# AI Orchestration (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# Speech-to-Text (Sarvam AI STT)
SARVAM_API_KEY=your_sarvam_api_key_here

# Text-to-Speech (Fish Audio TTS)
# All Fish Audio requests must originate from the backend service only.
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_BASE_URL=https://api.fish.audio/v1/tts

# Storage (S3 / R2 Compatible Object Storage)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=interviewos-assets

# Subscriptions & Payments (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Authentication (Google OAuth & JWT)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Observability (Optional)
SENTRY_DSN=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
