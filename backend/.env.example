# ==============================================================================
# InterviewOS Backend — Environment Variables (Phase 01)
# ==============================================================================
# Copy this file to backend/.env and populate with your configuration.
# Never commit actual credentials or secret values to Git.
# ==============================================================================

# Core Application Settings
PROJECT_NAME="InterviewOS API"
SERVICE_NAME="interviewos-api"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (comma separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Connection (PostgreSQL 15+)
# Example local or cloud URL: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
# Neon / Supabase URLs starting with postgres:// will be automatically normalized to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/interviewos

